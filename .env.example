# Preferred: one Slack app per crew member. Each token is that app's Bot User OAuth Token (xoxb-).
# Create the apps with: npm run links
# Then invite Maestro, Scout, Scribe, Pixel, Cutter, and Gatekeeper to #content.
SLACK_BOT_TOKEN_MAESTRO=
SLACK_BOT_TOKEN_SCOUT=
SLACK_BOT_TOKEN_SCRIBE=
SLACK_BOT_TOKEN_PIXEL=
SLACK_BOT_TOKEN_CUTTER=
SLACK_BOT_TOKEN_GATEKEEPER=

# Fallback: one app with the chat:write.customize scope.
# Messages still show the role name, but only one bot is a channel member.
SLACK_BOT_TOKEN=
